{
  "name": "auditpack-jira",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-egress Runs-on-Atlassian Forge app for Jira change-management audit evidence (SOC 2, ISO 27001, EU DORA).",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ui": "npm --prefix static/ui run build",
    "build": "npm run typecheck && npm run build:ui",
    "lint:forge": "forge lint",
    "deploy": "npm run build && forge deploy"
  },
  "dependencies": {
    "@forge/api": "^5.0.0",
    "@forge/kvs": "^1.0.0",
    "@forge/resolver": "^1.6.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
